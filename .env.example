# ─── Admin credentials ───────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=

# ─── Supabase Database (PostgreSQL) ──────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Use the TRANSACTION POOLER url (IPv4). The direct db.<ref>.supabase.co host is
# IPv6-only and will not resolve from Vercel.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── SMTP (for OTP & approval emails) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
ENQUIRY_EMAIL=

# ─── Site URL (for email links) ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# Dashboard → Settings → API Keys. Cloud name + API key + API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# Folder that all uploads are stored under
CLOUDINARY_FOLDER=
